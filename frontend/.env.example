# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_KEY

# Go API origin, without /api. Use your public HTTPS API origin in production.
# Go's ALLOWED_ORIGINS must include the website's exact origin, including its port.
NEXT_PUBLIC_API_URL=http://localhost:9000

# Legacy fallback; leave unset when NEXT_PUBLIC_API_URL is configured.
# NEXT_PUBLIC_GO_API_URL=http://localhost:9000
